{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "rootDir": "../",
    "outDir": "./dist",
    "moduleResolution": "Node16",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "../shared/**/*"
  ]
}